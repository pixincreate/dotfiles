{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",

  "profiles": {},

  "[opencode]": {
    "telemetry": false,
    "auto_update": true,
    "codegraph": {
      "auto_init": true,
      "auto_provision": true,
      "daemon": true,
      "enabled": true,
      "telemetry": false,
    },

    "model_fallback": false,

    "git_master": {
      "commit_footer": false,
      "include_co_authored_by": false,
      "git_env_prefix": "GIT_MASTER=1"
    },

    "agents": {
      "sisyphus": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": [
          "opencode/deepseek-v4-flash",
          "opencode-go/qwen3.7-plus",
          "opencode-go/deepseek-v4-pro",
          "opencode-go/minimax-m3",
        ],
      },
      "hephaestus": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": [
          "opencode/deepseek-v4-flash",
          "opencode-go/qwen3.7-plus",
          "opencode-go/deepseek-v4-pro",
          "opencode-go/minimax-m3",
        ],
      },
      "oracle": {
        "model": "opencode-go/deepseek-v4-pro",
        "fallback_models": [
          "opencode-go/qwen3.7-plus",
          "opencode-go/minimax-m3",
          "opencode-go/gpt-5.6-luna",
          "github-copilot/gpt-5.4",
        ],
      },
      "prometheus": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": [
          "opencode/deepseek-v4-flash",
          "opencode-go/qwen3.7-plus",
          "opencode-go/deepseek-v4-pro",
          "opencode-go/minimax-m3",
        ],
      },
      "atlas": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": [
          "opencode/deepseek-v4-flash",
          "opencode-go/qwen3.7-plus",
          "opencode-go/deepseek-v4-pro",
          "opencode-go/minimax-m3",
        ],
      },
      "explore": {
        "model": "opencode/deepseek-v4-flash-free",
        "fallback_models": [
          "opencode/big-pickle",
          "opencode-go/deepseek-v4-flash",
          "opencode-go/minimax-m3",
        ],
      },
      "librarian": {
        "model": "opencode/deepseek-v4-flash-free",
        "fallback_models": [
          "opencode/big-pickle",
          "opencode-go/deepseek-v4-flash",
          "opencode-go/minimax-m3",
        ],
      },
      "metis": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": [
          "opencode/deepseek-v4-flash",
          "opencode-go/qwen3.7-plus",
          "opencode-go/deepseek-v4-pro",
          "opencode-go/minimax-m3",
        ],
      },
      "momus": {
        "model": "opencode-go/qwen3.7-plus",
        "fallback_models": [
          "opencode-go/deepseek-v4-pro",
          "opencode-go/minimax-m3",
          "github-copilot/gpt-5.3-codex",
        ],
      },
    },

    "categories": {
      "quick": {
        "model": "opencode/deepseek-v4-flash-free",
        "fallback_models": [
          "opencode/big-pickle",
          "opencode-go/deepseek-v4-flash",
        ],
      },
      "unspecified-low": {
        "model": "opencode/deepseek-v4-flash-free",
        "fallback_models": [
          "opencode/big-pickle",
          "opencode-go/deepseek-v4-flash",
        ],
      },
      "unspecified-high": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": [
          "opencode/deepseek-v4-flash",
          "opencode-go/qwen3.7-plus",
          "opencode-go/deepseek-v4-pro",
          "opencode-go/minimax-m3",
        ],
      },
      "deep": {
        "model": "opencode-go/deepseek-v4-pro",
        "fallback_models": [
          "opencode-go/qwen3.7-plus",
          "opencode-go/minimax-m3",
          "opencode-go/gpt-5.6-luna",
        ],
      },
      "ultrabrain": {
        "model": "opencode-go/deepseek-v4-pro",
        "fallback_models": [
          "opencode-go/qwen3.7-plus",
          "opencode-go/minimax-m3",
          "opencode-go/gpt-5.6-luna",
        ],
      },
      "visual-engineering": {
        "model": "opencode-go/qwen3.7-plus",
        "fallback_models": [
          "opencode-go/deepseek-v4-pro",
          "opencode-go/minimax-m3",
          "opencode-go/gpt-5.6-luna",
        ],
      },
      "writing": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": [
          "opencode/deepseek-v4-flash",
          "opencode-go/qwen3.7-plus",
          "opencode-go/minimax-m3",
        ],
      },
    },

    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [429, 500, 502, 503, 504],
      "max_fallback_attempts": 3,
      "cooldown_seconds": 60,
      "timeout_seconds": 180,
      "notify_on_fallback": true,
    },

    "background_task": {
      "defaultConcurrency": 3,
      "providerConcurrency": {
        "opencode-go": 4,
        "opencode": 4,
        "github-copilot": 2,
      },
      "modelConcurrency": {
        "opencode-go/deepseek-v4-flash": 3,
        "opencode-go/qwen3.7-plus": 2,
        "opencode-go/deepseek-v4-pro": 1,
        "opencode-go/minimax-m3": 2,
        "opencode/deepseek-v4-flash-free": 3,
        "opencode/big-pickle": 2,
      },
    },
  },
}
