# rofimoji copies the selected emoji to the clipboard. Paste with Ctrl+V.
#
# Use "copy", not "clipboard". The "clipboard" action also sends a paste
# through the typer. KWin implements neither
# zwp_virtual_keyboard_manager_v1 nor zwp_input_method_manager_v2, so the
# paste fails. rofimoji then restores the previous clipboard content, which
# discards the emoji.
selector = fuzzel
action = copy
clipboarder = wl-copy
