      "enabled": true,
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
    },
  },
  "plugin": ["@tarquinen/opencode-dcp@latest", "oh-my-opencode@latest"],
  "provider": {},
}
