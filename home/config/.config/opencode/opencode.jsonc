{
  "$schema": "https://opencode.ai/config.json",

  "share": "disabled",
  "autoupdate": false,
  "subagent_depth": 1,
  "lsp": true,

  "mcp": {
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "kite": {
      "type": "remote",
      "url": "https://mcp.kite.trade/mcp",
      "enabled": true
    }
  },

  "enabled_providers": [
    "opencode-go",
    "opencode",
    "openai",
    "github-copilot",
    "ollama-cloud",
    "nvidia"
  ],

  "experimental": {
    "policies": [
      { "effect": "deny", "action": "provider.use", "resource": "anthropic" },
      { "effect": "deny", "action": "provider.use", "resource": "google" },
      { "effect": "deny", "action": "provider.use", "resource": "gemini" },
      { "effect": "deny", "action": "provider.use", "resource": "azure-openai" },
      { "effect": "deny", "action": "provider.use", "resource": "amazon-bedrock" },
      { "effect": "deny", "action": "provider.use", "resource": "google-vertex" },
      { "effect": "deny", "action": "provider.use", "resource": "openrouter" }
    ]
  },

  "permission": {
    "*": "allow",

    "bash": {
      "*": "allow",

      // Destructive commands - always deny
      "rm -rf *": "deny",
      "rm -rf /": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "chown -R *": "deny",
      "chmod -R 777 *": "deny",
      "chmod 777 *": "deny",
      "mkfs*": "deny",
      "dd *": "deny",

      // Credential access - always deny
      "cat ~/.ssh/*": "deny",
      "cat ~/.aws/*": "deny",
      "cat ~/.env*": "deny",
      "cat ~/.npmrc*": "deny",
      "cat ~/.netrc*": "deny",
      "cat ~/.pki/*": "deny",
      "cat ~/.kube/*": "deny",
      "less ~/.ssh/*": "deny",
      "head ~/.ssh/*": "deny",

      // Build/compile - ask (could be slow)
      "cargo build*": "ask",
      "cargo test*": "ask",
      "make *": "ask",
      "npm *": "ask",
      "yarn *": "ask",
      "pnpm *": "ask",
      "bun *": "ask",
      "pip *": "ask",
      "uv *": "ask",

      // Package install - ask (mutates system)
      "brew *": "ask",
      "cargo install*": "ask",
      "npm install*": "ask",
      "pip install*": "ask"
    },

    // File operations - ask before mutating
    "edit": "ask",
    "write": "ask",
    "external_directory": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "doom_loop": "deny",
    "skill": "allow",
    "question": "allow",
    "todowrite": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "read": "allow"
  },

  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "oh-my-openagent@latest"
  ],

  "provider": {}
}
