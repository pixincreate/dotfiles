{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",

  "telemetry": false,

  "model_fallback": false,

  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false,
    "git_env_prefix": "GIT_MASTER=1"
  },

  "agents": {
    "sisyphus": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": [
        "opencode-go/minimax-m3",
        "opencode-go/deepseek-v4-pro",
        "github-copilot/gpt-5.3-codex",
      ],
    },
    "hephaestus": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": [
        "opencode-go/minimax-m3",
        "opencode-go/deepseek-v4-pro",
        "github-copilot/gpt-5.3-codex",
      ],
    },
    "oracle": {
      "model": "opencode-go/glm-5.2",
      "fallback_models": [
        "opencode-go/qwen3.7-max",
        "opencode-go/minimax-m3",
        "github-copilot/gpt-5.4",
      ],
    },
    "prometheus": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": [
        "opencode-go/minimax-m3",
        "github-copilot/gpt-5.3-codex",
      ],
    },
    "atlas": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": [
        "opencode-go/minimax-m3",
        "github-copilot/gpt-5.3-codex",
      ],
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": ["opencode-go/mimo-v2.5"],
    },
    "librarian": {
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": ["opencode-go/mimo-v2.5"],
    },
    "metis": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": [
        "opencode-go/minimax-m3",
        "github-copilot/gpt-5.3-codex",
      ],
    },
    "momus": {
      "model": "opencode-go/minimax-m3",
      "fallback_models": ["opencode-go/glm-5.2", "github-copilot/gpt-5.4"],
    },
  },

  "categories": {
    "quick": {
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": ["opencode-go/mimo-v2.5"],
    },
    "unspecified-low": {
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": ["opencode-go/mimo-v2.5"],
    },
    "unspecified-high": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": [
        "opencode-go/minimax-m3",
        "github-copilot/gpt-5.3-codex",
      ],
    },
    "deep": {
      "model": "opencode-go/minimax-m3",
      "fallback_models": [
        "opencode-go/kimi-k2.7-code",
        "github-copilot/gpt-5.3-codex",
      ],
    },
    "ultrabrain": {
      "model": "opencode-go/glm-5.2",
      "fallback_models": [
        "opencode-go/qwen3.7-max",
        "opencode-go/minimax-m3",
        "github-copilot/gpt-5.4",
      ],
    },
    "visual-engineering": {
      "model": "opencode-go/qwen3.7-plus",
      "fallback_models": [
        "opencode-go/kimi-k2.7-code",
        "github-copilot/gpt-5.4",
      ],
    },
    "writing": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": [
        "github-copilot/gpt-5.4-mini",
        "opencode-go/minimax-m3",
      ],
    },
  },

  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [429, 500, 502, 503, 504],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60,
    "timeout_seconds": 180,
    "notify_on_fallback": true,
  },

  "background_task": {
    "defaultConcurrency": 3,
    "providerConcurrency": {
      "opencode-go": 4,
      "github-copilot": 2,
      "opencode": 1,
      "nvidia": 1,
    },
    "modelConcurrency": {
      "opencode-go/glm-5.2": 1,
      "opencode-go/qwen3.7-max": 1,
      "github-copilot/gpt-5.3-codex": 1,
      "github-copilot/gpt-5.4": 1,
    },
  },
}
