{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "image_preview": true
  },
  "animations": true,
  "debug": {
    "devtools": true
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.20000000000000004
  },
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "image_preview": true
  },
  "plugins": [
    "opencode-global-sessions",
    "opencode-mouth"
  ]
}
