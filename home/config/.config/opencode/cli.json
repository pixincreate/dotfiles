{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "mode": "system",
    "name": "system"
  },
  "keybinds": {
    "leader": "ctrl+x"
  },
  "scroll": {
    "speed": 3,
    "acceleration": true
  },
  "diffs": {
    "view": "auto",
    "single": false
  },
  "session": {
    "permissions": "prompt",
    "thinking": "show",
    "scrollbar": true,
    "image_preview": true,
    "verbosity": "medium"
  },
  "plugins": [
    {
      "package": "opencode-global-sessions",
      "options": {
        "limit": 50
      }
    },
    {
      "package": "opencode-mouth"
    }
  ],
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.30000000000000004
  },
  "animations": true,
  "tabs": {
    "mode": "auto",
    "layout": "horizontal",
    "indicators": "status"
  },
  "prompt": {
    "image_preview": true
  },
  "debug": {
    "devtools": true,
    "timing": false,
    "turn_tokens": true
  }
}
