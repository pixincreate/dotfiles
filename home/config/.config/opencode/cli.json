{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "mode": "system"
  },
  "keybinds": {
    "leader": "ctrl+x"
  },
  "scroll": {
    "speed": 3,
    "acceleration": true
  },
  "diffs": {
    "view": "auto"
  },
  "session": {
    "permissions": "prompt"
  },
  "plugins": [
    {
      "package": "opencode-global-sessions",
      "options": {
        "limit": 50
      }
    },
    {
      "package": "opencode-mouth"
    }
  ]
}
