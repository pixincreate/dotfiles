{
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "high",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "theme": "dark/dark",
  "packages": [
    "npm:pi-web-utils",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:@dietrichgebert/ponytail",
    "npm:pi-lens",
    "npm:pi-clarify"
  ],
  "enableInstallTelemetry": false,
  "terminal": {
    "showTerminalProgress": true
  }
}