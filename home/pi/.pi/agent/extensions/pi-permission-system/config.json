{
  "authorizerChain": ["pi-auto-review"],
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.env*": "deny",
      "~/.npmrc*": "deny",
      "~/.netrc*": "deny",
      "~/.pki/*": "deny",
      "~/.kube/*": "deny"
    },
    "edit": "ask",
    "write": "ask",
    "external_directory": "ask",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -rf /": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "chown -R *": "deny",
      "chmod -R 777 *": "deny",
      "chmod 777 *": "deny",
      "mkfs*": "deny",
      "dd *": "deny",
      "cat ~/.ssh/*": "deny",
      "cat ~/.aws/*": "deny",
      "cat ~/.env*": "deny",
      "cat ~/.npmrc*": "deny",
      "cat ~/.netrc*": "deny",
      "cat ~/.pki/*": "deny",
      "cat ~/.kube/*": "deny",
      "less ~/.ssh/*": "deny",
      "head ~/.ssh/*": "deny",
      "cargo build*": "ask",
      "cargo test*": "ask",
      "make *": "ask",
      "npm *": "ask",
      "yarn *": "ask",
      "pnpm *": "ask",
      "bun *": "ask",
      "pip *": "ask",
      "uv *": "ask",
      "brew *": "ask",
      "cargo install*": "ask",
      "npm install*": "ask",
      "pip install*": "ask"
    }
  }
}