{
  "subagents": {
    "provider": "builtin"
  },
  "hostIPC": {
    "mode": "ask",
    "preflightCommandPrefixes": [
      "docker compose ps",
      "docker compose up -d",
      "docker compose down",
      "docker compose exec app python manage.py test"
    ],
    "retryOnUnixSocketError": false
  },
  "filesystem": {
    "additionalAllowRead": []
  }
}